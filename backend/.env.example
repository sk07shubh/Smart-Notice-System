# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/notice_portal?schema=public

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# File storage (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_BUCKET_NAME=notice-attachments

# Email notifications
GMAIL_USER=notifications@example.com
GMAIL_APP_PASSWORD=replace-with-a-gmail-app-password
APP_URL=http://localhost:5173

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Accounts are never publicly registered. An existing ADMIN must create ADMIN/FACULTY
# accounts through POST /api/auth/create-account. Create the first ADMIN with
# `npx prisma db seed` (prisma/seed.ts) or directly in the database.
